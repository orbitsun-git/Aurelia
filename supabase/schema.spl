-- 1. 과목 테이블 생성 (Subjects)
CREATE TABLE IF NOT EXISTS public.subjects (
    id TEXT PRIMARY KEY,
    name TEXT NOT NULL,
    mascot_name TEXT NOT NULL,
    mascot_emoji TEXT NOT NULL,
    description TEXT,
    created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

-- 기본 과목 데이터 삽입
INSERT INTO public.subjects (id, name, mascot_name, mascot_emoji, description) VALUES
